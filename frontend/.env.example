# Optional. Port the backend listens on; the host is taken from the page URL. Default 8000.
# VITE_BACKEND_PORT=8000
# Optional. Full backend origin, overriding both host and port (e.g. backend on another machine).
# VITE_BACKEND_ORIGIN=http://192.168.1.50:8000
# Optional. Port the local Vite dev server binds to (bare `npm run dev`, outside
# Docker). Defaults to 5173, which is what the Docker dev stack's container-internal
# port must stay fixed at -- only change this for a bare host run that needs to avoid
# colliding with another stack already using 5173 on this machine.
# VITE_DEV_PORT=5173
