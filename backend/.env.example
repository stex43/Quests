# Copy this file to backend/.env for local runs.
# Docker reads backend/.env.docker instead (selected by APP_ENV=docker); that file is
# no longer tracked, so create it the same way — copy this file and set POSTGRES_HOST=db.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=False
# CORS_ORIGIN_REGEX defaults to a LAN-only pattern (localhost, private IPs, *.local).
# Set it empty to disable regex matching; the value is read as-is (not JSON).
# Wrap a custom pattern in single quotes: compose's env_file parser expands $ and
# python-dotenv processes escapes inside double quotes.
# CORS_ORIGIN_REGEX=
# ALLOWED_HOST_REGEX defaults to the same LAN-only pattern, matched against the Host header
# (host[:port]); requests for any other host get 400. Set it empty to disable the check.
# Wrap a custom pattern in single quotes, for the same reason as above.
# ALLOWED_HOST_REGEX=
