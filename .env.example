# Copy to .env at the deploy clone root (NOT this dev repo). docker compose reads this
# file itself, from its working directory, for ${VAR} interpolation and the project name
# — it is separate from backend/.env.docker, which holds the real DB credentials fed into
# the containers via env_file:.
COMPOSE_PROJECT_NAME=quests-deploy
BACKEND_PORT=8000
FRONTEND_PORT=5173
